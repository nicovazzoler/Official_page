---
import '@fontsource-variable/space-grotesk';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';
import { sitio } from '../datos/sitio';

const url = new URL(Astro.url.pathname, Astro.site);
const imagenOg = new URL('/compartir.png', Astro.site);

// Ficha para buscadores: un servicio profesional que atiende en zona oeste.
const fichaNegocio = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: sitio.nombre,
  description: sitio.descripcion,
  url: Astro.site?.href,
  image: imagenOg.href,
  areaServed: 'Zona oeste del Gran Buenos Aires, Argentina',
  founder: { '@type': 'Person', name: sitio.autor },
  sameAs: [sitio.linkedin],
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{sitio.titulo}</title>
    <meta name="description" content={sitio.descripcion} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#030405" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={sitio.titulo} />
    <meta property="og:description" content={sitio.descripcion} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="El robot de Vazzoler saludando, con el logo y el nombre debajo." />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(fichaNegocio)} />
  </head>
  <body>
    <div class="ambiente" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/ambiente';
      import '../scripts/revela';
    </script>
  </body>
</html>
