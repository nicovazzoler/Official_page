---
import { render, type CollectionEntry } from 'astro:content';
import Galeria from './Galeria.astro';
import { tonoDeProyecto } from '../lib/tonos';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}
const { proyecto } = Astro.props;
const { nombre, rubro, estado, color, datos, capturas } = proyecto.data;
const { Content } = await render(proyecto);
---

<article class="proyecto revela" style={`--tinte: ${color}`} {...tonoDeProyecto(color)}>
  <div class="texto">
    <div class="titulo">
      <p class="rubro">{rubro}</p>
      <h3>{nombre}</h3>
      <p class="estado"><i></i>{estado}</p>
    </div>
    <div class="cuerpo">
      <div class="descripcion"><Content /></div>
      {
        datos.length > 0 && (
          <dl class="datos">
            {datos.map((d) => (
              <>
                <dt>{d.etiqueta}</dt>
                <dd>{d.valor}</dd>
              </>
            ))}
          </dl>
        )
      }
    </div>
  </div>
  <Galeria nombre={nombre} capturas={capturas} />
</article>

<style>
  /* Primero quién es y qué hace; abajo, las capturas */
  .proyecto { display: grid; gap: 28px; }
  .texto, .titulo, .cuerpo { display: grid; gap: 18px; align-content: start; min-width: 0; }
  .rubro { font: 13px var(--f-mono); color: var(--tinte); letter-spacing: 0.04em; text-transform: uppercase; }
  h3 { font-size: clamp(34px, 4vw, 52px); }
  .estado { display: inline-flex; align-items: center; gap: 10px; font: 13px var(--f-mono); color: var(--suave); }
  .estado i { width: 8px; height: 8px; border-radius: 50%; background: var(--tinte); color: var(--tinte); animation: onda 2.2s ease-out infinite; }
  .descripcion { color: var(--suave); max-width: 60ch; }
  .descripcion :global(p + p) { margin-top: 1em; }
  .datos {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 22px;
    margin: 4px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--linea);
    font-size: 15px;
  }
  dt { font: 12.5px / 1.9 var(--f-mono); color: var(--tenue); }
  dd { margin: 0; color: var(--texto); }

  /* Escritorio: el nombre a la izquierda y la descripción a la derecha, la galería ancha abajo */
  @media (min-width: 960px) {
    .proyecto { gap: 40px; }
    .texto { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; }
  }
</style>
