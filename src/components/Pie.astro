---
import Marca from './Marca.astro';
import { sitio } from '../datos/sitio';
import { tonos } from '../lib/tonos';

const anio = new Date().getFullYear();
---

<footer {...tonos.turquesa}>
  <div class="envoltura pie">
    <div class="marca-pie">
      <Marca etiqueta={`${sitio.nombre}, volver al inicio`} />
      <p>Sistemas, páginas web y automatizaciones a medida para comercios de zona oeste.</p>
      {sitio.disponible && <p class="disponible"><i></i>Tomando proyectos nuevos</p>}
    </div>
    <div class="columnas">
      <nav aria-labelledby="pie-secciones">
        <h2 id="pie-secciones">Secciones</h2>
        <ul>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#trabajos">Trabajos</a></li>
          <li><a href="#como-trabajo">Cómo trabajo</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </nav>
      <div>
        <h2>Contacto</h2>
        <ul>
          <li><a href={sitio.whatsapp} target="_blank" rel="noopener">WhatsApp ↗</a></li>
          <li><a href={sitio.mail}>Mail ↗</a></li>
          <li><a href={sitio.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="gigante" aria-hidden="true"><span>{sitio.nombre}</span></div>
  <div class="legal">
    <div class="envoltura">
      <span>© {anio} {sitio.autor}</span>
      <span>Hecho a medida en zona oeste</span>
      <a href="#inicio">Volver arriba ↑</a>
    </div>
  </div>
</footer>

<style>
  .pie { display: grid; gap: 40px; padding-block: 64px 40px; }
  .marca-pie { display: grid; gap: 16px; align-content: start; max-width: 36ch; }
  .marca-pie > p { color: var(--suave); font-size: 15px; }
  .disponible { display: inline-flex; align-items: center; gap: 10px; font: 13px var(--f-mono); color: var(--texto); }
  .disponible i { width: 8px; height: 8px; border-radius: 50%; background: var(--verde); color: var(--verde); animation: onda 2.2s ease-out infinite; }

  .columnas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .columnas h2 {
    margin-bottom: 16px;
    font: 12px / 1 var(--f-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tenue);
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  ul a { color: var(--suave); text-decoration: none; font-size: 15px; transition: color 0.2s; }
  ul a:hover { color: var(--texto); }

  /* El nombre gigante se corta abajo a propósito */
  .gigante { overflow: hidden; height: calc(17.5vw * 0.62); user-select: none; pointer-events: none; }
  .gigante span {
    display: block;
    text-align: center;
    white-space: nowrap;
    font-family: var(--f-display);
    font-weight: var(--d-peso);
    font-size: 17.5vw;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    background: linear-gradient(180deg, rgb(94 234 212 / 0.32), rgb(94 234 212 / 0) 70%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .legal { border-top: 1px solid var(--linea); }
  .legal .envoltura {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px 32px;
    font: 12.5px var(--f-mono);
    color: var(--tenue);
  }
  .legal a { text-decoration: none; }
  .legal a:hover { color: var(--texto); }

  @media (min-width: 760px) {
    .pie { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
  }
</style>
