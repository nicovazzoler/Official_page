---
import Cta from './Cta.astro';
import Robot from './Robot.astro';
import { sitio } from '../datos/sitio';
import { tonos } from '../lib/tonos';
---

<section class="seccion" id="contacto" {...tonos.turquesa} aria-labelledby="t-contacto">
  <div class="envoltura contacto">
    <div class="texto revela">
      <h2 id="t-contacto">Contame qué necesita <span class="acento">tu negocio.</span></h2>
      <p>Te respondo yo, Nicolás. Si te queda cómodo, paso por tu local y lo vemos ahí.</p>
      <div class="canales">
        <Cta href={sitio.whatsapp}>Escribime por WhatsApp</Cta>
        <Cta href={sitio.mail} variante="secundaria">Mandame un mail</Cta>
        <Cta href={sitio.linkedin} variante="secundaria" etiqueta="Mi perfil de LinkedIn">Mi LinkedIn</Cta>
      </div>
    </div>
    <div class="robot-contacto">
      <Robot id="robot-contacto" />
    </div>
  </div>
</section>

<style>
  .contacto { display: grid; gap: 36px; align-items: center; }
  .texto { display: grid; gap: 28px; min-width: 0; }
  h2 { font-size: clamp(40px, 6vw, 84px); }
  .texto > p { color: var(--suave); font-size: clamp(17px, 1.5vw, 20px); max-width: 44ch; }
  .canales { display: grid; justify-items: start; gap: 16px; }

  .robot-contacto { position: relative; width: min(220px, 56%); aspect-ratio: 360 / 420; margin: 0 auto; }
  .robot-contacto::before {
    content: '';
    position: absolute;
    inset: 10% 0 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(212 238 94 / 0.12), transparent);
  }
  .robot-contacto :global(.robot) { position: relative; width: 100%; height: 100%; }

  @media (min-width: 760px) {
    .contacto { grid-template-columns: 1.3fr 0.7fr; }
  }
  @media (min-width: 960px) {
    .robot-contacto { width: 100%; max-width: 280px; }
  }
</style>
