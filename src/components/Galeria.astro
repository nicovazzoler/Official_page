---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

// Capturas de un proyecto que se pasan con el dedo (scroll-snap); puntos y flechas para el mouse.
interface Props {
  nombre: string;
  capturas: CollectionEntry<'proyectos'>['data']['capturas'];
}
const { nombre, capturas } = Astro.props;

// Ancho en pantalla de cada tipo, para que el navegador baje el tamaño justo.
const tamanos = {
  compu: { widths: [480, 720, 960, 1280, 1600], sizes: '(min-width: 1180px) 920px, (min-width: 960px) 78vw, 86vw' },
  celu: { widths: [240, 400, 600], sizes: '(min-width: 960px) 280px, 30vw' },
  papel: { widths: [300, 500, 700], sizes: '(min-width: 960px) 420px, 50vw' },
};
---

<div class="galeria">
  <div class="carril" tabindex="0" aria-label={`Capturas de ${nombre}`}>
    {
      capturas.map((c) => (
        <figure class:list={['slide', c.tipo]}>
          <Picture
            src={c.archivo}
            alt={c.alt}
            formats={['avif']}
            fallbackFormat="webp"
            widths={tamanos[c.tipo].widths}
            sizes={tamanos[c.tipo].sizes}
            class="foto"
            loading="lazy"
          />
          <figcaption>{c.epigrafe}</figcaption>
        </figure>
      ))
    }
  </div>

  {
    capturas.length > 1 && (
      <div class="control">
        <button class="flecha" type="button" data-ir="-1" aria-label="Captura anterior" disabled>←</button>
        <div class="puntos">
          {capturas.map((_, i) => (
            <button class="punto" type="button" data-punto={i} aria-label={`Ver captura ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} />
          ))}
        </div>
        <button class="flecha" type="button" data-ir="1" aria-label="Captura siguiente">→</button>
        <span class="contador">1 / {capturas.length}</span>
      </div>
    )
  }
</div>

<script>
  import '../scripts/galeria';
</script>

<style>
  .galeria { display: grid; gap: 14px; min-width: 0; }
  .carril {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 22px;
    overscroll-behavior-x: contain;
  }
  .carril::-webkit-scrollbar { display: none; }

  /* La diapositiva no ocupa todo el ancho: se ve el borde de la siguiente e invita a deslizar */
  .slide {
    flex: 0 0 86%;
    scroll-snap-align: start;
    margin: 0;
    position: relative;
    aspect-ratio: 16 / 10;
    max-width: 100%;
    border-radius: 22px;
    overflow: hidden;
    background:
      radial-gradient(80% 70% at 70% 20%, color-mix(in srgb, var(--tinte) 30%, transparent), transparent 70%),
      linear-gradient(160deg, #0D1628, #070C18);
  }
  .slide :global(.foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  /* Teléfono que asoma desde abajo */
  .celu :global(.foto) {
    inset: auto;
    left: 50%;
    top: 7%;
    width: auto;
    height: 93%;
    transform: translateX(-50%);
    border-radius: 24px 24px 0 0;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08), 0 24px 60px rgb(0 0 0 / 0.55);
  }
  /* Ticket apoyado, apenas girado */
  .papel :global(.foto) {
    inset: auto;
    left: 50%;
    top: 7%;
    width: auto;
    height: 86%;
    transform: translateX(-50%) rotate(-2deg);
    border-radius: 4px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.55);
  }
  figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 6px 9px;
    border-radius: 6px;
    font: 12px / 1 var(--f-mono);
    color: var(--texto);
    background: rgb(3 6 12 / 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .control { display: flex; align-items: center; gap: 14px; }
  .puntos { display: flex; gap: 4px; flex-wrap: wrap; }
  .punto { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; background: none; cursor: pointer; }
  .punto::before { content: ''; width: 8px; height: 8px; border-radius: 99px; background: var(--tenue); transition: width 0.3s ease, background 0.3s ease; }
  .punto[aria-current='true']::before { width: 22px; background: var(--tinte); }
  .contador { margin-left: auto; font: 13px var(--f-mono); color: var(--tenue); }
  .flecha {
    display: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--linea);
    background: transparent;
    color: var(--texto);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .flecha:hover { border-color: var(--tinte); background: color-mix(in srgb, var(--tinte) 10%, transparent); }
  .flecha:disabled { opacity: 0.3; cursor: default; }

  @media (min-width: 760px) {
    .flecha { display: grid; }
  }
  @media (min-width: 960px) {
    .carril { gap: 16px; }
    .slide { flex-basis: 80%; }
  }
</style>
